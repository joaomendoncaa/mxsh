# Ramo uses a single config file with a simple `key = value` syntax. The file is
# looked up in the following order (first match wins):
#
# $XDG_CONFIG_HOME/ramo/config
# $XDG_CONFIG_HOME/ramo/config.ramo
# $HOME/.config/ramo/config
# $HOME/.config/ramo/config.ramo
#
# If `XDG_CONFIG_HOME` is unset or empty, it defaults to `$HOME/.config`. If no config file is found, ramo starts with built-in defaults and prints a warning.
#
# The syntax is "key = value". The whitespace around the
# equals doesn't matter.
# `path = ~/Projects/*`
#
# Comments start with a `#` and are only valid on their own line.
# Blank lines are ignored!
#
# Empty values reset the configuration to the default value
# `path-worktrees =`
#
# Every config key can also be overridden from the command line. Boolean keys can
# be passed as bare flags (meaning `true`); all others use `--key=value`:
#
# `ramo --auto-close`
# `ramo --path="~/Projects/*" --daemon-timeout=120`
#
# You can obviously delete all these comments when you feel confortable with the config,
# but I'd leave them for reference later on.
#
# You can open and edit this file in-app with `? Help`.
#
# ██████╗ ███████╗███████╗ █████╗ ██╗   ██╗██╗  ████████╗
# ██╔══██╗██╔════╝██╔════╝██╔══██╗██║   ██║██║  ╚══██╔══╝
# ██║  ██║█████╗  █████╗  ███████║██║   ██║██║     ██║
# ██║  ██║██╔══╝  ██╔══╝  ██╔══██║██║   ██║██║     ██║
# ██████╔╝███████╗██║     ██║  ██║╚██████╔╝███████╗██║
# ╚═════╝ ╚══════╝╚═╝     ╚═╝  ╚═╝ ╚═════╝ ╚══════╝╚═╝
#
#  ██████╗ ██████╗ ███╗   ██╗███████╗██╗ ██████╗
# ██╔════╝██╔═══██╗████╗  ██║██╔════╝██║██╔════╝ ██╗
# ██║     ██║   ██║██╔██╗ ██║█████╗  ██║██║  ███╗╚═╝
# ██║     ██║   ██║██║╚██╗██║██╔══╝  ██║██║   ██║██╗
# ╚██████╗╚██████╔╝██║ ╚████║██║     ██║╚██████╔╝╚═╝
#  ╚═════╝ ╚═════╝ ╚═╝  ╚═══╝╚═╝     ╚═╝ ╚═════╝

# you can define a custom path for the directories
# you want to create sessions from, including
# where you want to host your worktrees
path = ~/Projects/*
path-worktrees = ~/Projects/worktrees

# be careful with defining custom bindings due to
# modifier shenanigans, feel free to open an issue
# if something doesn't seem right
# bind syntax: comma-separated keys, each like "enter", "esc", "up", "down",
# "left", "right", "backspace", "delete", "a", "?", ":" or with modifiers
# "ctrl-p", "alt-b", "ctrl-c". Use lower-case; modifiers are ctrl/alt/shift.
bind-jumpto = enter
bind-command-mode = :
bind-help = ?
bind-quit = esc,ctrl-c,ctrl-q
bind-nav-up = up,ctrl-p
bind-nav-down = down,ctrl-n
bind-nav-page-up = ctrl-u
bind-nav-page-down = ctrl-d
bind-input-left = left
bind-input-right = right
bind-input-home = ctrl-a
bind-input-end = ctrl-e
bind-input-kill-line = ctrl-k
bind-input-delete-word = ctrl-w
bind-input-clear = ctrl-r
bind-input-word-left = alt-b
bind-input-word-right = alt-f
bind-input-backspace = backspace
bind-input-delete = delete
bind-command-exit = esc,backspace
bind-command-open-detached = o
bind-help-enter = enter
bind-help-exit = esc
bind-command-session-kill = k # uses `kill-session` in tmux, so it doesn't delete your worktree or agent session
bind-command-worktree-new = n # filter input is used as the branch name, empty input auto-names
bind-command-worktree-delete = d # `git worktree remove --force` + kills its sessions

# defines if the picker should close after jumping to a session
auto-close = true

hide-changes-inactive = false
hide-changes-active = false
hide-changes-worktree = false
hide-hints-footer = false
hide-hints-branches-active = false
hide-hints-branches-inactive = false
hide-hints-remotes-active = false
hide-hints-remotes-inactive = false

style-icon-daemon-loading = ─╲│╱
style-icon-daemon-ready = ✓
style-icon-active = *
style-icon-worktree = ⑂
style-icon-agent-idle = ✓
style-icon-agent-running = ⠋⠙⠹⠸⢰⣰⣠⣄⣆⡆⠇⠏
style-icon-input = ▸

# add empty lines in-between entries
# (the same count pads the input row, above and below)
style-entries-gap = 0

# comma-separated opencode agent names to ignore
opencode-agents-ignored =

# the daemon is thin when idle: with no picker connected it only does a
# light keep-warm refresh every 30s (~0% CPU), so it can happily run at
# login forever. it still self-destructs after this many idle seconds
# when not running under systemd
# value in seconds
daemon-timeout = 300
